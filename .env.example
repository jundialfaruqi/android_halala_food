# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE - HALALA FOOD ANDROID
# ==============================================================================
# Pilih salah satu konfigurasi di bawah ini dan simpan sebagai file ".env"
# Contoh:
# Untuk development lokal: salin bagian [LOCAL]
# Untuk rilis production: salin bagian [PRODUCTION]
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PENGATURAN LOCAL / DEVELOPMENT (DEFAULT)
# ------------------------------------------------------------------------------
APP_NAME="Halala Food"
APP_ENV=development

# Emulator Android menggunakan 10.0.2.2 sebagai localhost komputer
BASE_URL=http://10.0.2.2:8000/api
API_TIMEOUT=30000

# WebSocket Reverb Lokal
REVERB_APP_KEY=halalafoodkey123
REVERB_HOST=10.0.2.2
REVERB_PORT=8080
REVERB_SCHEME=http

# ------------------------------------------------------------------------------
# 2. PENGATURAN PRODUCTION (CONTOH)
# ------------------------------------------------------------------------------
# APP_NAME="Halala Food"
# APP_ENV=production
# BASE_URL=https://api.halala-food.com/api
# API_TIMEOUT=30000
# REVERB_APP_KEY=reverb_key_dari_server_production
# REVERB_HOST=api.halala-food.com
# REVERB_PORT=443
# REVERB_SCHEME=https
