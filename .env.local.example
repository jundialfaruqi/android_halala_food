# ==============================================================================
# HALALA FOOD - FLUTTER ENVIRONMENT (PENGEMBANGAN / LOCAL)
# ==============================================================================
# Salin file ini menjadi ".env" saat menjalankan di komputer pengembang:
# cp .env.local.example .env

APP_NAME="Halala Food"
APP_ENV=development

# ------------------------------------------------------------------------------
# API CONFIGURATION
# ------------------------------------------------------------------------------
# - Android Emulator: Gunakan "http://10.0.2.2:8000/api" (10.0.2.2 adalah alias localhost komputer host)
# - HP Fisik (Kabel USB / Wi-Fi): Gunakan IP lokal komputer (misal: "http://192.168.1.50:8000/api")
# - Laravel Herd: Bisa juga "http://halala-food.test/api" jika jaringan HP & PC terhubung DNS lokal
BASE_URL=http://10.0.2.2:8000/api
API_TIMEOUT=30000

# ------------------------------------------------------------------------------
# LARAVEL REVERB (WEBSOCKET REAL-TIME) - LOCAL
# ------------------------------------------------------------------------------
# Samakan nilai REVERB_APP_KEY dengan yang ada di web-halala-food/.env
REVERB_APP_KEY=halalafoodkey123

# Host Reverb:
# - Emulator: "10.0.2.2"
# - HP Fisik: IP lokal komputer (misal: "192.168.1.50")
REVERB_HOST=10.0.2.2

# Port default Reverb saat dijalankan via "php artisan reverb:start"
REVERB_PORT=8080

# Scheme lokal adalah "http" (koneksi ws:// tidak terenkripsi)
REVERB_SCHEME=http
